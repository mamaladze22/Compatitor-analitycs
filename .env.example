# Apify — get from https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets
# 1. Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# 2. Download its key as JSON, save somewhere safe, point this var at it
# 3. Share your target Sheet with the service account email (Editor access)
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service-account.json

# The Sheet ID is the long string in the Sheet URL:
# https://docs.google.com/spreadsheets/d/{THIS_PART}/edit
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
